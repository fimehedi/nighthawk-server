# Server Configuration
MODE=dev
DEV_PORT=5000
PROD_PORT=5000
DEV_HOST=localhost
PROD_HOST=0.0.0.0

# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
SHADOW_DATABASE_URL="mysql://username:password@localhost:3306/shadow_database_name"
DEV_DB_URI=mongodb://localhost:27017/dev_db
PROD_DB_URI=mongodb://localhost:27017/prod_db

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Patreon OAuth Configuration
# Get these from: https://www.patreon.com/portal/registration/register-clients
PATREON_CLIENT_ID=your_patreon_client_id_here
PATREON_CLIENT_SECRET=your_patreon_client_secret_here
PATREON_REDIRECT_URI=http://localhost:5000/api/patreon/callback

# Patreon Campaign ID (find this in your Patreon creator dashboard)
# This ensures only patrons of YOUR campaign can access downloads
PATREON_CAMPAIGN_ID=your_campaign_id_here

# Frontend URL (for OAuth redirect after successful login)
# Set this to your Next.js frontend URL
FRONTEND_URL=http://localhost:3000
